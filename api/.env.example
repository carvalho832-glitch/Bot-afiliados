# Chave da OpenAI usada somente no servidor para gerar as mensagens da Clara.
# Nunca publique a chave real no GitHub nem a envie ao navegador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_REQUESTS_PER_HOUR=180

# Credenciais existentes da API oficial da Shopee.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Opcional e recomendado: use o mesmo token no Render e no servidor do bot.
# Sem ele, a rota usa as credenciais Basic já configuradas para a ponte do bot.
SHOPEE_TRACKING_TOKEN=
SHOPEE_TRACKING_LIMIT_PER_10_MIN=120
