# Chave da OpenAI usada somente no servidor para gerar as mensagens da Clara.
# Nunca publique a chave real no GitHub nem a envie ao navegador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_REQUESTS_PER_HOUR=180

# Credenciais usadas pelas consultas gerais de produto e como compatibilidade
# temporária do rastreamento antigo.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Cada bot usa seu token exclusivo. O token seleciona as credenciais da conta
# correta sem enviar APP_ID ou SECRET para o WhatsApp ou para o navegador.
SHOPEE_JULIO_APP_ID=
SHOPEE_JULIO_SECRET=
SHOPEE_TRACKING_TOKEN_JULIO=

SHOPEE_RENATA_APP_ID=
SHOPEE_RENATA_SECRET=
SHOPEE_TRACKING_TOKEN_RENATA=

# Compatibilidade durante a migração. Remova depois que os dois bots estiverem
# usando seus tokens exclusivos.
SHOPEE_TRACKING_TOKEN=
SHOPEE_TRACKING_LIMIT_PER_10_MIN=120
