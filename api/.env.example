# Chave criada no Google AI Studio. Nunca publique a chave real no GitHub.
GEMINI_API_KEY=

# Modelo estável usado na geração. Pode ser alterado sem editar o código.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_REQUESTS_PER_HOUR=120

# Credenciais existentes da API oficial da Shopee.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Opcional e recomendado: use o mesmo token no Render e no servidor do bot.
# Sem ele, a rota usa as credenciais Basic já configuradas para a ponte do bot.
SHOPEE_TRACKING_TOKEN=
SHOPEE_TRACKING_LIMIT_PER_10_MIN=120
