# Chave da OpenAI usada somente no servidor para gerar as mensagens da Clara.
# Nunca publique a chave real no GitHub nem a envie ao navegador.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_REQUESTS_PER_HOUR=180

# Credenciais usadas pelas consultas gerais de produto e como compatibilidade
# temporária do rastreamento antigo.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Cada bot usa seu token exclusivo. O token seleciona as credenciais da conta
# correta sem enviar APP_ID ou SECRET para o WhatsApp ou para o navegador.
SHOPEE_JULIO_APP_ID=
SHOPEE_JULIO_SECRET=
SHOPEE_TRACKING_TOKEN_JULIO=

SHOPEE_RENATA_APP_ID=
SHOPEE_RENATA_SECRET=
SHOPEE_TRACKING_TOKEN_RENATA=

# Compatibilidade durante a migração. Remova depois que os dois bots estiverem
# usando seus tokens exclusivos.
SHOPEE_TRACKING_TOKEN=
SHOPEE_TRACKING_LIMIT_PER_10_MIN=120

# Controle administrativo da VM do bot no Google Cloud.
# No Render basta configurar a URL do controlador. O Bearer recebido do cliente
# é encaminhado ao Cloud Run, que é a única camada que valida VM_ADMIN_TOKEN.
VM_CONTROLLER_URL=

# VM_ADMIN_TOKEN só é necessário no próprio Cloud Run ou no modo direto legado.
# Não é necessário duplicar este segredo no Render quando VM_CONTROLLER_URL existe.
VM_ADMIN_TOKEN=

# Metadados do alvo, usados apenas para diagnóstico da rota /admin/vm/config.
GCP_PROJECT_ID=
GCP_VM_ZONE=
GCP_VM_INSTANCE=

# Compatibilidade com o modo direto antigo. Preferir VM_CONTROLLER_URL.
GCP_SERVICE_ACCOUNT_JSON=
GCP_SERVICE_ACCOUNT_JSON_B64=
