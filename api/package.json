{
  "name": "achou-levou-api",
  "version": "1.3.0",
  "description": "Backend do Achou Levou com Shopee, Magalu, Gemini e ponte segura para o robô",
  "type": "module",
  "main": "front-entry.js",
  "scripts": {
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "start": "node apply-gemini-patch.cjs && PLAYWRIGHT_BROWSERS_PATH=0 node front-entry.js",
    "check": "node --check front-gateway.js && node --check shopee-affiliate-service.js",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.54.1"
  },
  "engines": {
    "node": ">=18"
  }
}
