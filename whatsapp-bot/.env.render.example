# Perfil deste serviço: julio OU renata
BOT_PROFILE=julio
WHATSAPP_CLIENT_ID=achou-levou-julio
TZ=America/Sao_Paulo

# O Render define PORT automaticamente. Deixe 3010 apenas para testes locais.
PORT=3010

# Backup periódico do LocalAuth + fila + configurações.
# 600 = 10 minutos.
CLOUD_BACKUP_INTERVAL_SECONDS=600

# Cloudflare R2 privado, usado para persistir .wwebjs_auth e data/.
R2_ACCOUNT_ID=
R2_BUCKET=achou-levou-bot-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional. Se vazio, usa achou-levou/<BOT_PROFILE>/state.tar.gz
R2_BACKUP_KEY=

# Configuração já existente do bot.
GROUPS_READ_TIMEOUT_MS=15000
MESSAGE_SEND_TIMEOUT_MS=45000
BOT_API_KEY=
BOT_ALLOWED_ORIGINS=*

# Geração oficial de links Shopee com Sub_ids por grupo.
SHOPEE_TRACKING_API_URL=https://bot-afiliados-1fwi.onrender.com/shopee/rastrear
SHOPEE_TRACKING_TOKEN=
SHOPEE_TRACKING_TIMEOUT_MS=45000
SHOPEE_TRACKING_TIME_ZONE=America/Sao_Paulo
